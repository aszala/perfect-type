{
  "name": "perfect-type",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulators",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "emulators": "npx --yes firebase-tools@15 emulators:start --only auth,firestore --project demo-perfect-type",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project demo-perfect-type \"vitest run --config vitest.rules.config.js\"",
    "deploy:rules": "npx --yes firebase-tools@15 deploy --only firestore:rules --project perfect-type"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "firebase": "^13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.46.4",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
